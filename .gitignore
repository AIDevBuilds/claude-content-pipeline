# ── Secrets ───────────────────────────────────────────────────────────────────
# Never commit these. .env.example is the committed template.
.env
.env.local
.env.*.local
.env.production
.env.development
*.pem
*.key
credentials.json
service-account*.json

# ── Local configuration ───────────────────────────────────────────────────────
# Your identity/brand values. config.example.json is the committed template.
config.json
# Personal Claude Code instructions for this project (see Claude Code docs).
CLAUDE.local.md

# ── Private notes ─────────────────────────────────────────────────────────────
# Personal notes (e.g. the content-limit files in config). Never commit.
private/

# ── Generated content ─────────────────────────────────────────────────────────
# This is a tooling repo. Your drafts, scripts and images stay local.
blog-data/*
!blog-data/.gitkeep
video-data/*
!video-data/.gitkeep
# Render scratch anywhere (e.g. video-data/.cache/shorts/). Safe to delete.
**/.cache/

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Claude Code ───────────────────────────────────────────────────────────────
# settings.json IS committed (it carries the shared permission rules).
# settings.local.json holds machine-specific paths and must not be.
.claude/settings.local.json

# ── OS / editors ──────────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.log
