#!/usr/bin/env python3
"""Pre-commit guard: refuse a commit that would publish something personal.

A control, not a reminder: prompts and rules ask the agents not to leak personal
details into public files; this blocks the commit if one slipped through anyway.

Install once per clone (git never copies hooks):
    ln -sf ../../scripts/pre-commit .git/hooks/pre-commit

What it refuses, all read from the STAGED version of each file:
  1. Staged paths that are always private: private/, blog-data/, video-data/
     (except .gitkeep), config.json, CLAUDE.local.md, .env files, and media or
     spreadsheet exports. Add your own globs, one per line, to
     private/local-only-paths.txt.
  2. Personal terms in staged text: values from your config.json (author name,
     role, bio, tagline, channel URLs and handles, newsletter name) plus any line
     in private/public-denylist.txt. The brand name is allowed; it is public.
  3. A failing scripts/validate.py.

Bypass on purpose only: git commit --no-verify
Standard library only, so it runs with any python3.
"""
import fnmatch
import json
import re
import subprocess
import sys
from pathlib import Path

REPO = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, check=True).stdout.strip())

ALWAYS_PRIVATE = [
    "private/*", "config.json", "CLAUDE.local.md",
    ".env", ".env.*", "*.pem", "*.key",
    "*.xlsx", "*.xls", "*.csv", "*.mp3", "*.wav", "*.m4a", "*.mp4", "*.mov",
]
DATA_DIRS = ("blog-data/", "video-data/")
ALLOWED = {".env.example", "blog-data/.gitkeep", "video-data/.gitkeep"}
TEXT_SUFFIXES = {"", ".md", ".json", ".py", ".sh", ".ts", ".tsx", ".js", ".html",
                 ".css", ".txt", ".yml", ".yaml", ".toml", ".svg"}


def staged_paths() -> list[str]:
    out = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"],
                         capture_output=True, text=True, check=True, cwd=REPO).stdout
    return [p for p in out.split("\0") if p]


def staged_text(path: str) -> str | None:
    if Path(path).suffix.lower() not in TEXT_SUFFIXES:
        return None
    blob = subprocess.run(["git", "show", f":{path}"], capture_output=True, cwd=REPO).stdout
    try:
        return blob.decode("utf-8")
    except UnicodeDecodeError:
        return None


def read_lines(rel: str) -> list[str]:
    f = REPO / rel
    if not f.is_file():
        return []
    return [l.strip() for l in f.read_text(encoding="utf-8").splitlines()
            if l.strip() and not l.lstrip().startswith("#")]


def config_terms() -> list[str]:
    f = REPO / "config.json"
    if not f.is_file():
        return []
    cfg = json.loads(f.read_text(encoding="utf-8"))
    ident, chans = cfg.get("identity", {}), cfg.get("channels", {})
    author = ident.get("author", {})
    terms = [author.get("name"), author.get("role"), author.get("bio"), ident.get("tagline")]
    for chan in chans.values():
        if not isinstance(chan, dict):
            continue
        for key, val in chan.items():
            if key in ("platform",) or not isinstance(val, str):
                continue
            terms.append(re.sub(r"^https?://(www\.)?", "", val).rstrip("/"))
    brand = (ident.get("brandName") or "").lower()
    return [t for t in terms if isinstance(t, str) and len(t.strip()) >= 4 and t.lower() != brand]


def main() -> int:
    paths = staged_paths()
    if not paths:
        return 0
    problems: list[str] = []

    globs = ALWAYS_PRIVATE + read_lines("private/local-only-paths.txt")
    for p in paths:
        if p in ALLOWED:
            continue
        if p.startswith(DATA_DIRS) or any(fnmatch.fnmatch(p, g) or fnmatch.fnmatch(Path(p).name, g)
                                          or p.startswith(g.rstrip("*").rstrip("/") + "/") for g in globs):
            problems.append(f"{p}: private path, must not be committed")

    terms = config_terms() + read_lines("private/public-denylist.txt")
    patterns = [(t, re.compile(re.escape(t), re.IGNORECASE)) for t in dict.fromkeys(terms)]
    for p in paths:
        text = staged_text(p)
        if text is None:
            continue
        for n, line in enumerate(text.splitlines(), 1):
            for term, pat in patterns:
                if pat.search(line):
                    shown = term if len(term) <= 40 else term[:37] + "..."
                    problems.append(f"{p}:{n}: contains personal term '{shown}'")

    ident = subprocess.run(["git", "var", "GIT_AUTHOR_IDENT"], capture_output=True, text=True, cwd=REPO).stdout
    email = ident[ident.find("<") + 1:ident.find(">")] if "<" in ident else ""
    for term, pat in patterns:
        if email and pat.search(email):
            problems.append(f"commit author email <{email}> contains personal term '{term}'"
                            " (use a noreply address: git config user.email ...)")

    validator = REPO / "scripts" / "validate.py"
    if validator.is_file():
        run = subprocess.run([sys.executable, str(validator)], capture_output=True, text=True, cwd=REPO)
        if run.returncode != 0:
            problems.append("scripts/validate.py failed:\n" + run.stdout[-1500:])

    if problems:
        print("pre-commit: commit refused, nothing was committed.\n", file=sys.stderr)
        for line in problems[:40]:
            print("  - " + line, file=sys.stderr)
        if len(problems) > 40:
            print(f"  ... and {len(problems) - 40} more", file=sys.stderr)
        print("\nFix the files (or unstage them) and commit again.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
